<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikon kecil notifikasi peringatan cuaca ekstrem (Fase 9, temuan F6 L1).

  Menggantikan `android.R.drawable.stat_notify_error` milik framework, yang
  tampilannya berbeda-beda antar ROM dan metaforanya keliru: peringatan cuaca
  bukan "error" aplikasi.

  ATURAN YANG TIDAK BOLEH DILANGGAR — ikon kecil notifikasi dirender Android
  sebagai SILUET dari kanal alpha saja. Seluruh warna diabaikan; yang dibaca
  hanya bentuk buram versus transparan. Karena itu:

    - semua path WAJIB putih penuh (#FFFFFFFF), tanpa gradien,
    - latar WAJIB transparan (tidak ada path yang menutup seluruh kanvas),
    - kanvas 24dp, BUKAN 108dp seperti ic_launcher_foreground.

  Melanggarnya menghasilkan KOTAK PUTIH PENUH di status bar, sementara build
  tetap sukses dan lint tetap bersih. Tidak ada pemeriksaan otomatis di repo ini
  yang bisa menangkapnya.

  Bentuk: awan (y 3-15) dengan tiga garis hujan di bawahnya (y 17-21). Awan
  memakai path awan Material standar yang diperkecil lewat <group> agar
  menyisakan ruang untuk hujan — TANPA itu awannya memenuhi y 4-20 dan garis
  hujannya terpotong keluar kanvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:scaleX="0.78"
        android:scaleY="0.6"
        android:translateX="2.6"
        android:translateY="0.6">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96z" />
    </group>

    <!-- Tiga garis hujan miring. Panjangnya sengaja tidak sama supaya
         siluetnya tetap terbaca sebagai hujan pada ukuran 24dp. -->
    <path
        android:pathData="M8,17.2 L6.9,20.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M12.4,17.2 L11.1,21.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M16.8,17.2 L15.7,20.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
</vector>
