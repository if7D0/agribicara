<?xml version="1.0" encoding="utf-8"?>
<!--
  Database lokal dikecualikan dari backup/transfer.

  Saat ini hanya berisi flag onboarding, tetapi tabel yang direncanakan
  (riwayat chat Fase 5, riwayat deteksi penyakit Fase 4) berisi data pribadi
  petani. Data itu tidak boleh ikut tersinkron ke server backup atau
  ter-restore ke perangkat lain hanya karena akun yang sama login.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" path="user_preference.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
