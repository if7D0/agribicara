<?xml version="1.0" encoding="utf-8"?>
<!--
  Varian bulat. Bukan opsional: sebagian launcher OEM membaca android:roundIcon
  dan mengabaikan android:icon. Transsion (Infinix, perangkat uji proyek ini)
  termasuk di antaranya.

  Isinya sengaja identik dengan ic_launcher.xml - bentuk bulatnya datang dari
  mask sistem, bukan dari berkas ini.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
