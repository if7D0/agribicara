<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      WAJIB, bukan opsional. Sejak Android 11 (API 30) package visibility
      menyembunyikan layanan milik aplikasi lain, dan project ini targetSdk 37.
      Tanpa dua blok di bawah, SpeechRecognizer.isRecognitionAvailable()
      mengembalikan false dan TextToSpeech gagal menemukan engine - BAHKAN di
      HP yang Google services-nya lengkap. Sumber: javadoc resmi
      SpeechRecognizer.createSpeechRecognizer dan TextToSpeech.

      Gejalanya menyesatkan: aplikasi tampak berjalan normal tapi selalu jatuh
      ke jalur teks. Jangan dihapus.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Mikrofon tidak diwajibkan: perangkat tanpa mic tetap boleh memasang
         aplikasi dan memakai jalur input teks. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".AgriBicaraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgriBicara">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AgriBicara"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
