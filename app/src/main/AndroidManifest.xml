<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Notifikasi peringatan cuaca ekstrem (Fase 6). Izin runtime sejak API 33;
      di bawah itu otomatis diberikan.

      Ditolak = TIDAK ada fungsi lain yang berkurang. Aplikasi ini tetap bisa
      dipakai penuh tanpa notifikasi, sama seperti perangkat tanpa mikrofon
      tetap boleh memasangnya.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      WAJIB, bukan opsional. Sejak Android 11 (API 30) package visibility
      menyembunyikan layanan milik aplikasi lain, dan project ini targetSdk 37.
      Tanpa dua blok di bawah, SpeechRecognizer.isRecognitionAvailable()
      mengembalikan false dan TextToSpeech gagal menemukan engine - BAHKAN di
      HP yang Google services-nya lengkap. Sumber: javadoc resmi
      SpeechRecognizer.createSpeechRecognizer dan TextToSpeech.

      Gejalanya menyesatkan: aplikasi tampak berjalan normal tapi selalu jatuh
      ke jalur teks. Jangan dihapus.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Mikrofon tidak diwajibkan: perangkat tanpa mic tetap boleh memasang
         aplikasi dan memakai jalur input teks. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".AgriBicaraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgriBicara">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AgriBicara"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WAJIB, bukan opsional. AgriBicaraApp mengimplementasikan
          Configuration.Provider supaya WorkManager memakai HiltWorkerFactory.
          Provider bawaan androidx.startup menginisialisasi WorkManager LEBIH
          DULU dengan pabrik bawaannya, sehingga konfigurasi Hilt tidak pernah
          terpakai dan WeatherCheckWorker gagal dibuat saat runtime.

          Gejalanya menyesatkan: build tetap sukses dan aplikasi tetap jalan.
          Kegagalannya baru terlihat ketika worker benar-benar dijalankan.
          Jangan dihapus.

          PERHATIAN - yang dihapus HANYA meta-data milik WorkManager, BUKAN
          provider-nya. InitializationProvider adalah titik masuk BERSAMA untuk
          seluruh androidx App Startup: emoji2 (font emoji), profileinstaller
          (baseline profile - startup rilis di perangkat murah), dan
          lifecycle-process (ProcessLifecycleOwner) semuanya menumpang di sana.
          tools:node="remove" pada provider mematikan ketiganya sekaligus, dan
          tidak ada satu pun test, lint, atau build yang menangkapnya.
          Verifikasi ada di ManifestInitializerTest.
        -->
        <!--
          FileProvider untuk deteksi penyakit (Fase 4). Kamera sistem menulis
          foto ke cacheDir/detection/ lewat content Uri ini; tidak ada izin
          CAMERA yang diminta karena ACTION_IMAGE_CAPTURE ditangani aplikasi
          kamera, bukan aplikasi ini.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
