# Templat material penanda tangan build rilis (Fase 8).
#
# Salin berkas ini menjadi `keystore.properties` di root proyek, lalu isi dengan
# nilai keystore Anda sendiri. Berkas aslinya TIDAK PERNAH di-commit — `*.jks`,
# `*.keystore`, dan `keystore.properties` sudah masuk .gitignore sejak Fase 1.
#
# Tanpa berkas ini, `assembleRelease` dan `bundleRelease` tetap berjalan dan
# menghasilkan artefak UNSIGNED. Itu disengaja: CI membangun rilis tanpa punya
# keystore sama sekali (lihat .github/workflows/ci.yml).
#
# Membuat keystore baru:
#
#   export JAVA_HOME="C:/Program Files/Android/Android Studio/jbr"
#   "$JAVA_HOME/bin/keytool" -genkeypair -v \
#     -keystore agribicara-upload.jks \
#     -alias agribicara-upload \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12
#
# -validity 10000 bukan gaya-gayaan: Google Play menolak upload key yang
# kedaluwarsa sebelum 22 Oktober 2033.
#
# -storetype PKCS12 ditulis eksplisit supaya keytool tidak mencetak peringatan
# migrasi dari format JKS yang sudah warisan — peringatan yang mudah
# disalahartikan sebagai error.
#
# PERINGATAN: kehilangan keystore ini berarti TIDAK BISA LAGI mengunggah update
# untuk applicationId yang sama, selamanya. Play App Signing menyelamatkan app
# signing key milik Google, BUKAN upload key Anda. Simpan cadangannya di luar
# repo — repo privat pun bukan tempatnya.

# Path relatif terhadap root proyek, atau path absolut.
storeFile=agribicara-upload.jks
storePassword=GANTI_DENGAN_PASSWORD_KEYSTORE_ANDA
keyAlias=agribicara-upload
keyPassword=GANTI_DENGAN_PASSWORD_KEY_ANDA
